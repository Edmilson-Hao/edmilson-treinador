rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isPersonal() {
      return isSignedIn() && userDoc().data.role == 'personal';
    }
    function isAluno() {
      return isSignedIn() && userDoc().data.role == 'aluno';
    }

    function validRoleChange() {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.role
          || (resource.data.role == 'pending' && request.resource.data.role in ['personal', 'aluno']);
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow get: if isOwner(userId)
                 || (isPersonal() && resource.data.personalId == request.auth.uid)
                 || (isSignedIn() && resource.data.role == 'personal');

      // Personals (convite) OU documentos cujo personalId é o usuário (alunos)
      allow list: if isSignedIn() && (
        resource.data.role == 'personal'
        || resource.data.personalId == request.auth.uid
      );

      allow create: if isOwner(userId)
                    && request.resource.data.role in ['pending', 'personal', 'aluno'];

      // Aluno/personal edita o próprio perfil; personal pode atualizar dados básicos do aluno
      allow update: if (isOwner(userId) && validRoleChange())
                    || (isPersonal()
                        && resource.data.personalId == request.auth.uid
                        && resource.data.role == 'aluno');

      allow delete: if false;
    }

    // ---------- EXERCISES ----------
    match /exercises/{exId} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.personalId == '__global__'
      );

      allow create: if isPersonal()
                    && request.resource.data.keys().hasAll(['name', 'personalId'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && (
                      request.resource.data.personalId == request.auth.uid
                      || request.resource.data.personalId == '__global__'
                    );

      allow update, delete: if isPersonal() && (
        resource.data.personalId == request.auth.uid
        || resource.data.personalId == '__global__'
      );
    }

    // ---------- ROUTINES ----------
    match /routines/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // ---------- WORKOUTS ----------
    match /workouts/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // ---------- COMPLETED ----------
    match /completedWorkouts/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isAluno()
                    && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        (isPersonal() && resource.data.personalId == request.auth.uid)
        || (isAluno() && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['coachReplyRead', 'coachReplyReadAt']))
      );
      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- PLANS ----------
    match /plans/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid
                    && request.resource.data.value is number
                    && request.resource.data.value >= 0
                    && request.resource.data.value <= 100000;
      allow update: if isSignedIn() && (
        (isPersonal() && resource.data.personalId == request.auth.uid)
        || (isAluno() && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'studentClaimedAt'])
            && request.resource.data.status in ['aguardando', 'pendente', 'ativo'])
      );
      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- ROUTINE TEMPLATES (biblioteca) ----------
    match /routineTemplates/{id} {
      allow get, list: if isSignedIn() && resource.data.personalId == request.auth.uid;
      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // ---------- CHAT ----------
    match /chatMessages/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.personalId is string
        && request.resource.data.studentId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
    }

    // ---------- REMINDERS ----------
    match /reminders/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create, update: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;
      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- ANAMNESES ----------
    match /anamneses/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create, update: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid
        || request.resource.data.personalId == request.auth.uid
      );
      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }
  }
}
