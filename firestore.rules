rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPersonal() {
      return isSignedIn() && userDoc().data.role == 'personal';
    }

    function isAluno() {
      return isSignedIn() && userDoc().data.role == 'aluno';
    }

    function isMyPersonal(personalId) {
      return isAluno() && userDoc().data.personalId == personalId;
    }

    // ---------- USERS ----------
    match /users/{userId} {
      // Qualquer autenticado pode ler seu próprio doc
      allow read: if isOwner(userId)
                  || (isPersonal() && resource.data.personalId == request.auth.uid)
                  || (isSignedIn() && resource.data.role == 'personal'); // alunos precisam achar personal pelo código

      // Criar só o próprio documento
      allow create: if isOwner(userId);

      // Atualizar só o próprio
      allow update: if isOwner(userId);

      allow delete: if false;
    }

    // ---------- EXERCISES ----------
    match /exercises/{exId} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        isMyPersonal(resource.data.personalId)
      );
      allow create: if isPersonal() && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- ROUTINES ----------
    match /routines/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isPersonal() && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- WORKOUTS ----------
    match /workouts/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isPersonal() && request.resource.data.personalId == request.auth.uid;
      allow update, delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- COMPLETED WORKOUTS ----------
    match /completedWorkouts/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAluno() && request.resource.data.studentId == request.auth.uid;
      allow update: if isPersonal() && resource.data.personalId == request.auth.uid;
      allow delete: if false;
    }

    // ---------- PLANS ----------
    match /plans/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create, update: if isPersonal() && request.resource.data.personalId == request.auth.uid;
      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- ANAMNESES ----------
    match /anamneses/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.personalId == request.auth.uid
      );
      allow update, delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // ---------- REMINDERS ----------
    match /reminders/{id} {
      allow read, write: if isPersonal() && resource.data.personalId == request.auth.uid;
      allow create: if isPersonal() && request.resource.data.personalId == request.auth.uid;
    }
  }
}
