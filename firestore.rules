rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPersonal() {
      return isSignedIn() && userDoc().data.role == 'personal';
    }

    function isAluno() {
      return isSignedIn() && userDoc().data.role == 'aluno';
    }

    function isMyPersonal(personalId) {
      return isAluno() && userDoc().data.personalId == personalId;
    }

    // Impede que aluno tente se promover a personal
    function validRoleChange() {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.role
          || (resource.data.role == 'pending' && request.resource.data.role in ['personal', 'aluno']);
    }

    // =====================================================
    // USERS
    // =====================================================
    match /users/{userId} {
      // Leitura: próprio doc OU personal lendo seus alunos OU busca de personal por código
      allow get: if isOwner(userId)
                 || (isPersonal() && resource.data.personalId == request.auth.uid)
                 || (isSignedIn() && resource.data.role == 'personal');

      // List (query) só para personal listar seus alunos
      allow list: if isPersonal();

      allow create: if isOwner(userId)
                    && request.resource.data.role in ['pending', 'personal', 'aluno'];

      allow update: if isOwner(userId) && validRoleChange();

      allow delete: if false;
    }

    // =====================================================
    // EXERCISES
    // =====================================================
    match /exercises/{exId} {
      // Lista padrão (__global__) legível por todos autenticados
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.personalId == '__global__'
        || isMyPersonal(resource.data.personalId)
      );

      // Personal cria na lista própria; admin pode criar em __global__
      allow create: if isPersonal()
                    && request.resource.data.keys().hasAll(['name', 'personalId'])
                    && (
                      request.resource.data.personalId == request.auth.uid
                      || request.resource.data.personalId == '__global__'
                    );

      allow update, delete: if isPersonal() && (
        resource.data.personalId == request.auth.uid
        || resource.data.personalId == '__global__'
      );
    }

    // =====================================================
    // ROUTINES
    // =====================================================
    match /routines/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );

      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid
                    && request.resource.data.studentId is string;

      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // =====================================================
    // WORKOUTS
    // =====================================================
    match /workouts/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );

      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;

      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // =====================================================
    // COMPLETED WORKOUTS (feedback + histórico)
    // =====================================================
    match /completedWorkouts/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );

      // Só o aluno pode criar (concluir treino)
      allow create: if isAluno()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.personalId == userDoc().data.personalId;

      // Personal resolve feedback + aluno marca mensagem como lida
      allow update: if isSignedIn() && (
        (isPersonal()
          && resource.data.personalId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resolved', 'resolvedAt', 'coachReply', 'coachReplyAt', 'coachReplyRead']))
        ||
        (isAluno()
          && resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['coachReplyRead', 'coachReplyReadAt']))
      );

      allow delete: if isPersonal() && resource.data.personalId == request.auth.uid;
    }

    // =====================================================
    // PLANS
    // =====================================================
    match /plans/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );

      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;

      allow update: if isPersonal()
                    && resource.data.personalId == request.auth.uid;

      allow delete: if isPersonal()
                    && resource.data.personalId == request.auth.uid;
    }

    // =====================================================
    // ANAMNESES
    // =====================================================
    match /anamneses/{id} {
      allow get, list: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid
        || request.resource.data.personalId == request.auth.uid
      );

      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }

    // =====================================================
    // REMINDERS
    // =====================================================
    match /chatMessages/{id} {
      allow read: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (
          (isPersonal() && request.resource.data.personalId == request.auth.uid)
          || (isAluno() && request.resource.data.studentId == request.auth.uid
              && request.resource.data.personalId == userDoc().data.personalId)
        );
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.personalId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
    }

    match /reminders/{id} {
      allow get, list: if isPersonal()
                       && resource.data.personalId == request.auth.uid;

      allow create: if isPersonal()
                    && request.resource.data.personalId == request.auth.uid;

      allow update, delete: if isPersonal()
                            && resource.data.personalId == request.auth.uid;
    }
  }
}
